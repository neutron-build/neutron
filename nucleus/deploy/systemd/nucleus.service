# Nucleus — systemd unit
#
# STATUS: WRITTEN, NOT YET RUN. This file has never been loaded by a systemd
# instance; the development machine is macOS. `nucleus/deploy/README.md` has
# the exact verification sequence to run on a Linux host before trusting it.
#
# Install:
#   install -m 0644 nucleus.service /etc/systemd/system/nucleus.service
#   install -m 0640 -o root -g nucleus nucleus.env /etc/nucleus/nucleus.env
#   systemctl daemon-reload && systemctl enable --now nucleus

[Unit]
Description=Nucleus multi-model database
Documentation=https://github.com/neutron-build/neutron
# network-online, not network: the server binds a specific address and fails
# at startup if it is not yet configured.
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple, NOT notify. Nucleus does not implement sd_notify — there is no
# NOTIFY_SOCKET handling anywhere in the binary — so systemd considers the
# unit started the moment it forks, before the listener is accepting.
# Anything that must wait for readiness should poll:
#     nucleus status --host 127.0.0.1:5432
Type=simple

User=nucleus
Group=nucleus

# Creates and chowns /var/lib/nucleus, and keeps it across restarts.
StateDirectory=nucleus
StateDirectoryMode=0700
WorkingDirectory=/var/lib/nucleus

# Secrets (NUCLEUS_PASSWORD, NUCLEUS_ENCRYPT_KEY, NUCLEUS_WAL_ARCHIVE_DIR, …)
# belong here, not on the command line, where they would be world-readable in
# /proc/<pid>/cmdline. `-` means "start anyway if the file is absent".
EnvironmentFile=-/etc/nucleus/nucleus.env

ExecStart=/usr/local/bin/nucleus start \
    --data /var/lib/nucleus \
    --host 127.0.0.1 \
    --port 5432

# SIGTERM is handled: the server drains connections, then flushes dirty pages
# and seals the WAL. The drain budget is a hard 2 s (DRAIN_BUDGET_SECS in
# src/main.rs); the flush that follows is NOT bounded and scales with buffer
# pool size, so TimeoutStopSec is deliberately far above the drain figure.
# If systemd SIGKILLs during the flush the database still recovers from the
# WAL, but recovery on next start is longer.
KillSignal=SIGTERM
TimeoutStopSec=120

Restart=on-failure
RestartSec=5s

# A database opens a file descriptor per connection, per WAL segment and per
# model-specific store. The kernel default of 1024 is too low.
LimitNOFILE=65535
# Do not let systemd's default core-dump handling write a heap image of the
# whole buffer pool into /var/lib/systemd/coredump.
LimitCORE=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nucleus

# --- Hardening -------------------------------------------------------------
# Each of these has been chosen against what the binary actually does; they
# are still UNVERIFIED until the unit has been started. If startup fails,
# `systemd-analyze security nucleus.service` plus the journal will say which
# one is responsible — comment it out rather than deleting the whole block.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# ProtectSystem=strict makes everything outside StateDirectory read-only.
# PITR archiving writes outside the data directory, so if you set
# NUCLEUS_WAL_ARCHIVE_DIR you MUST add it here or archiving fails with EROFS:
#   ReadWritePaths=/var/backups/nucleus-wal

[Install]
WantedBy=multi-user.target
