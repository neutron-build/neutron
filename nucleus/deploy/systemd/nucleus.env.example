# /etc/nucleus/nucleus.env — read by nucleus.service via EnvironmentFile.
# Mode 0640, owned root:nucleus. Values are NOT shell-expanded by systemd:
# write literals, no quotes, no $VAR.
#
# Names below are the ones `src/main.rs` actually reads; see
# `docs/CONFIG_REFERENCE.md` for the generated, authoritative list.

# --- Authentication --------------------------------------------------------
# Required unless the server binds loopback only. A non-loopback bind with no
# password refuses to start unless NUCLEUS_ALLOW_NO_AUTH=1 is also set, which
# is a development escape hatch and must never be used in production.
NUCLEUS_PASSWORD=

# scram-sha256 (default) or cleartext. Do not use cleartext.
# NUCLEUS_AUTH_METHOD=scram-sha256

# --- Encryption at rest ----------------------------------------------------
# Hex-encoded 32-byte key, or a passphrase for Argon2 derivation. Only takes
# effect with `--encrypt` on the command line. LOSING THIS MAKES THE DATA
# DIRECTORY UNREADABLE — there is no recovery path.
# NUCLEUS_ENCRYPT_KEY=
# NUCLEUS_ENCRYPT_PASSPHRASE=

# --- Point-in-time recovery ------------------------------------------------
# Enables continuous WAL archiving. This path is OUTSIDE the data directory,
# so ProtectSystem=strict blocks it until it is added to ReadWritePaths= in
# the unit file. See docs/runbooks/BACKUP_RESTORE_PITR.md.
# NUCLEUS_WAL_ARCHIVE_DIR=/var/backups/nucleus-wal

# --- Memory ----------------------------------------------------------------
# Megabytes shared across buffer pool, cache, KV, FTS and columnar.
# NUCLEUS_MAX_MEMORY_MB=512

# --- Cluster (M9 — incomplete and unsupported; see README.md) --------------
# NUCLEUS_CLUSTER_TOKEN=
