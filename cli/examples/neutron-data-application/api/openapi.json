    "schemas": {
      "CreateDocument": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Exact decimal input, normalized to canonical18 fractional digits before digest.",
            "pattern": "^-?[0-9]{1,22}(\\.[0-9]{1,18})?$",
            "type": "string"
          },
          "content": {
            "description": "At most 65536 UTF-8 bytes.",
            "type": "string"
          },
          "id": {
            "description": "ASCII UUID; canonicalized to lowercase.",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "description": "Required member; null and empty text are distinct. Valid Unicode, no NUL or unpaired surrogate.",
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "contentEncoding": "base64",
            "description": "Standard padded base64 encoding of exact bytes; strict decode then canonical re-encode.",
            "type": "string"
          },
          "project_id": {
            "description": "ASCII UUID; canonicalized to lowercase.",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "content",
          "amount",
          "note",
          "payload",
          "idempotency_key"
        ],
        "type": "object"
      },
