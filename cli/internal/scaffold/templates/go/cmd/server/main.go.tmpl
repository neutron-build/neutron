package main

import (
	"context"
	"log/slog"
	"net"
	"os"

	"{{.Module}}/internal/handler"
	"github.com/neutron-build/neutron/go/neutron"
	"github.com/neutron-build/neutron/go/nucleus"
)

func main() {
	var level slog.Level // info unless NEUTRON_LOG_LEVEL says otherwise
	_ = level.UnmarshalText([]byte(os.Getenv("NEUTRON_LOG_LEVEL")))
	logger := slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: level}))

	dbURL := os.Getenv("NEUTRON_DATABASE_URL")
	if dbURL == "" {
		dbURL = os.Getenv("DATABASE_URL")
	}
	if dbURL == "" {
		dbURL = "postgres://localhost:5432/{{.Name}}"
	}

	db, err := nucleus.Connect(context.Background(), dbURL)
	if err != nil {
		logger.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}

	app := neutron.New(
		neutron.WithLogger(logger),
		neutron.WithLifecycle(db.LifecycleHook()),
		neutron.WithNucleusChecker(db),
		// FRAMEWORK_CONTRACT §5 order, outermost first.
		neutron.WithMiddleware(neutron.RequestID(), neutron.Logger(logger), neutron.Recover()),
	)

	handler.Register(app.Router())

	// FRAMEWORK_CONTRACT §6: listen on NEUTRON_HOST:NEUTRON_PORT, default :8080.
	// GET /health is built in.
	port := os.Getenv("NEUTRON_PORT")
	if port == "" {
		port = "8080"
	}
	if err := app.Run(net.JoinHostPort(os.Getenv("NEUTRON_HOST"), port)); err != nil {
		logger.Error("server stopped", "error", err)
		os.Exit(1)
	}
}
