{
  "name": "neutron-native-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "modules/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter neutron-native-cli dev",
    "test": "jest --config jest.config.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "^1.1.20",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "node-forge@<1.4.1": "^1.4.1",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "fast-uri@>=4.0.0 <4.1.4": "^4.1.4",
      "fastify@<5.12.2": "^5.12.2",
      "follow-redirects@<1.16.2": "^1.16.2",
      "handlebars@<4.7.10": "^4.7.10",
      "launch-editor@<2.14.2": "^2.14.2",
      "image-size@<2.0.3": "^2.0.3"
    }
  }
}
