}

type corpusStatement struct {
	SQL  string
	Args []any
}

var corpusIdentifier = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)

func loadCorpusScenario(t *testing.T) corpusScenario {
	t.Helper()
	raw, err := os.ReadFile(corpusScenarioFile)
	if err != nil {
		t.Fatal("shared corpus scenario is missing from the test directory")
	}
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.UseNumber()
	decoder.DisallowUnknownFields()
	var scenario corpusScenario
	if err := decoder.Decode(&scenario); err != nil {
		t.Fatalf("shared corpus scenario is invalid: %v", err)
	}
	if scenario.Version != 1 {
		t.Fatal("unsupported shared corpus scenario version")
	}
	return scenario
}

// corpusSeedStatements returns identical INSERT statements for both harnesses.
// Identifiers are validated, values are always bound parameters.
func corpusSeedStatements(t *testing.T, scenario corpusScenario) []corpusStatement {
	t.Helper()
	var statements []corpusStatement
	for _, block := range scenario.Seed {
		if !corpusIdentifier.MatchString(block.Table) {
			t.Fatal("invalid seed table identifier")
		}
		quoted := make([]string, len(block.Columns))
		for i, column := range block.Columns {
			if !corpusIdentifier.MatchString(column) {
				t.Fatal("invalid seed column identifier")
			}
			quoted[i] = `"` + column + `"`
		}
		for _, row := range block.Rows {
			if len(row) != len(block.Columns) {
				t.Fatalf("seed row width mismatch in %s", block.Table)
			}
			args := make([]any, len(row))
			marks := make([]string, len(row))
			for i, value := range row {
				marks[i] = fmt.Sprintf("$%d", i+1)
				switch typed := value.(type) {
				case nil:
					args[i] = nil
				case string:
					args[i] = typed
				case json.Number:
					number, err := typed.Int64()
					if err != nil {
						t.Fatalf("seed value is not an integer in %s", block.Table)
					}
					args[i] = number
				default:
					t.Fatalf("unsupported seed value type in %s", block.Table)
				}
			}
			statements = append(statements, corpusStatement{
				SQL:  `INSERT INTO "` + block.Table + `" (` + strings.Join(quoted, ", ") + `) VALUES (` + strings.Join(marks, ", ") + `)`,
				Args: args,
			})
		}
	}
	for _, statement := range scenario.AfterSeed {
		statements = append(statements, corpusStatement{SQL: statement})
	}
	return statements
}

const corpusUserSnapshotSQL = `SELECT user_id::text, username, nick_name, phone, email, role_id::text, dept_id::text, post_id::text, remark, status, avatar, sex, create_by::text, update_by::text, (deleted_at > 0)::text FROM sys_user WHERE user_id = $1`

var corpusUserSnapshotColumns = []string{"user_id", "username", "nick_name", "phone", "email", "role_id", "dept_id", "post_id", "remark", "status", "avatar", "sex", "create_by", "update_by", "deleted"}

// corpusSnapshotRecord keeps SQL NULL (nil) distinct from the empty string.
func corpusSnapshotRecord(values []*string) map[string]any {
	record := map[string]any{}
	for i, name := range corpusUserSnapshotColumns {
		if values[i] == nil {
			record[name] = nil
		} else {
			record[name] = *values[i]
		}
	}
	return record
}

// corpusErrorClass reduces an error to a stable class without server text.
func corpusErrorClass(err error, isNotFound func(error) bool) string {
	if err == nil {
		return ""
	}
	switch err.Error() {
	case corpusMessageNotVisible:
		return "not_visible"
	case corpusMessageRemoveDenied:
		return "remove_denied"
	case corpusMessageDuplicate:
		return "duplicate_username"
	case corpusMessageUpdateFailed:
		return "update_failed"
	}
	if isNotFound(err) {
		return "record_not_found"
	}
	return "error"
}

type corpusTranscript struct {
	name    string
	entries map[string]any
}

func newCorpusTranscript(name string) *corpusTranscript {
	return &corpusTranscript{name: name, entries: map[string]any{}}
}

func (c *corpusTranscript) record(key string, value any) {
	if _, exists := c.entries[key]; exists {
		panic("duplicate transcript key " + key)
	}
	c.entries[key] = value
}

// write stores the transcript only when the coordinator names a directory. The
// transcript holds scenario observations only; it never holds connection data.
func (c *corpusTranscript) write(t *testing.T) {
	t.Helper()
	dir := os.Getenv(corpusTranscriptEnv)
	if dir == "" {
		return
	}
	var buffer bytes.Buffer
	encoder := json.NewEncoder(&buffer)
	encoder.SetEscapeHTML(false)
	encoder.SetIndent("", " ")
	if err := encoder.Encode(c.entries); err != nil {
		t.Fatal("transcript encoding failed")
	}
	if err := os.WriteFile(filepath.Join(dir, c.name+".json"), buffer.Bytes(), 0o600); err != nil {
		t.Fatal("transcript write failed")
	}
}
