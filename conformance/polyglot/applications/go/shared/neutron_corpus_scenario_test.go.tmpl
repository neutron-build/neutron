	PostID         string `json:"postId"`
	Status         string `json:"status"`
	DeptID         string `json:"deptId"`
	UserIDOrder    string `json:"userIdOrder"`
	UsernameOrder  string `json:"usernameOrder"`
	StatusOrder    string `json:"statusOrder"`
