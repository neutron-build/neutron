// Shared by the unchanged-original and the converted native harnesses. It uses
// only the standard library, so both sides execute one scenario definition and
// write transcripts in one format. It contains no application behavior.
package __PACKAGE__

import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"testing"
)

const (
	corpusScenarioFile  = "neutron_corpus_scenario.json"
	corpusTranscriptEnv = "NEUTRON_GO_APP_TRANSCRIPT_DIR"

	corpusMessageNotVisible   = "查看对象不存在或无权查看"
	corpusMessageRemoveDenied = "无权删除该数据"
	corpusMessageDuplicate    = "用户名已存在！"
	corpusMessageUpdateFailed = "update userinfo error"
)

type corpusSeedTable struct {
	Table   string   `json:"table"`
	Columns []string `json:"columns"`
	Rows    [][]any  `json:"rows"`
}

