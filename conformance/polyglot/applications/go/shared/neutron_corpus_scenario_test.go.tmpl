	Version    int               `json:"version"`
	AfterSeed  []string          `json:"afterSeed"`
	Seed       []corpusSeedTable `json:"seed"`
	Queries    []corpusQuery     `json:"queries"`
	Operations []corpusOperation `json:"operations"`
}

