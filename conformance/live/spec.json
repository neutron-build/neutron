      "id": "document.round_trip",
      "model": "document",
      "steps": [
        {
          "op": "document.insert",
          "args": [
            "@coll",
            {
              "title": "hello",
              "n": 1
            }
          ],
          "bind": "docId"
        },
        {
          "op": "document.getIn",
          "args": [
            "@coll",
            "$docId"
          ],
          "expect": {
            "key": "title",
            "equals": "hello"
          }
        },
        {
          "op": "document.update",
          "args": [
            "@coll",
            {
              "title": "hello"
            },
            {
              "title": "changed"
            }
          ],
          "expect": {
            "equals": 1
          }
        },
        {
          "op": "document.getIn",
          "args": [
            "@coll",
            "$docId"
          ],
          "expect": {
            "key": "title",
            "equals": "changed"
          }
        },
        {
          "op": "document.delete",
          "args": [
            "@coll",
            {
              "title": "changed"
            }
          ],
          "expect": {
            "equals": 1
          }
        },
        {
          "op": "document.getIn",
          "args": [
            "@coll",
            "$docId"
          ],
          "expect": {
            "isNull": true
          }
        }
      ]
