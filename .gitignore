**/do_edit.py
**/edit_distributed.py
**/coord_lines.py
**/coord_methods.rs

# Rust framework (rust/) — the SOURCE is tracked. Only the cargo build output is
# ignored. (Earlier this was `/rust/` under the mistaken belief the source lived
# in `rs/`; `rs/` was renamed to `rust/` in 6079213, so `/rust/` was silently
# excluding the entire framework from version control. Fixed to ignore only target/.)
/rust/target/

# Site build output (source is tracked, dist is not)
typescript/apps/site/dist/
typescript/apps/site/.neutron/
# Same for the playground: .neutron/runtime/entry.node.ts is emitted by
# `neutron-ts build`, so a tracked copy goes stale the moment the codegen
# changes and dirties the tree on every build.
typescript/apps/playground/.neutron/

# Claude internal
.claude/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Rust — track the framework + engine lockfiles for reproducible builds.
# (The `!rs/Cargo.lock` exception was stale: `rs/` was renamed to `rust/` in
# 6079213, so the framework lockfile silently went untracked.)
Cargo.lock
!rust/Cargo.lock
!nucleus/Cargo.lock
