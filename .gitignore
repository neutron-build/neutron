# Third-party benchmark apps are tracked like every other subject app — an
# ignored subject is a benchmark row nobody else can reproduce. Their own
# .gitignore files keep node_modules and build output out.

# Observe (separate project)
typescript/apps/observe/

# Zig build artifacts
zig/.zig-cache/
zig/zig-out/

