{
  "name": "@neutron-build/cms",
  "version": "0.1.1",
  "description": "A small CMS for Neutron sites: posts, photo galleries, events and any list, edited at /n-admin. No database server and no JavaScript for visitors.",
  "author": "Tyler",
  "license": "MIT",
  "homepage": "https://neutron.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "typescript/packages/neutron-cms"
  },
  "keywords": [
    "neutron",
    "cms",
    "sqlite",
    "blog",
    "gallery"
  ],
  "type": "module",
  "bin": {
    "neutron-cms": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./photo": {
      "types": "./dist/photo.d.ts",
      "import": "./dist/photo.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "node scripts/embed.mjs && tsc",
    "lint": "node scripts/embed.mjs && tsc --noEmit --pretty false",
    "test": "pnpm run build && node --test --no-warnings dist/*.test.js",
    "test:browser": "pnpm run build && node --no-warnings test/browser/run.mjs"
  },
  "dependencies": {
    "marked": "15.0.12",
    "preact-render-to-string": "^6.5.0"
  },
  "peerDependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.0",
    "preact": "^10.25.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "sideEffects": false
}
