{
  "name": "@neutron-build/cli",
  "version": "0.2.1",
  "description": "CLI for the Neutron framework. Dev server, production builds, and deployment.",
  "author": "Tyler",
  "license": "MIT",
  "homepage": "https://neutron.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "typescript/packages/neutron-cli"
  },
  "keywords": [
    "neutron",
    "cli",
    "dev-server",
    "build-tool",
    "vite"
  ],
  "type": "module",
  "bin": {
    "neutron-ts": "./bin/neutron-ts.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "test": "pnpm run build && node --test --experimental-test-isolation=none dist/index.test.js"
  },
  "dependencies": {
    "@neutron-build/core": "workspace:^",
    "preact": "^10.25.4",
    "preact-render-to-string": "^6.5.11",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
