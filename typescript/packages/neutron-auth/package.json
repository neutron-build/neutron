{
  "name": "@neutron-build/auth",
  "version": "0.1.3",
  "description": "Authentication context and protected-route middleware for Neutron.",
  "author": "Tyler",
  "license": "MIT",
  "homepage": "https://neutron.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "typescript/packages/neutron-auth"
  },
  "keywords": [
    "neutron",
    "auth",
    "authentication",
    "better-auth",
    "middleware"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "test": "pnpm run build && node --test --experimental-test-isolation=none dist/index.test.js"
  },
  "dependencies": {
    "@neutron-build/core": "workspace:^"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.22 <2"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "better-auth": "1.6.25",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
