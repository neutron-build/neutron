{
  "name": "@neutron-build/data",
  "version": "0.1.1",
  "description": "Data layer for Neutron. Database (Drizzle), cache, sessions, queues, storage, and rate limiting.",
  "author": "Tyler",
  "license": "MIT",
  "homepage": "https://neutron.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "typescript/packages/neutron-data"
  },
  "keywords": [
    "neutron",
    "data",
    "database",
    "drizzle",
    "cache",
    "session",
    "queue"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "test": "pnpm run build && node --test --experimental-test-isolation=none \"dist/**/*.test.js\""
  },
  "dependencies": {
    "cron-parser": "^4.9.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@libsql/client": "^0.17.0",
    "@neutron-build/nucleus": "workspace:^",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^5.8.1",
    "postgres": "^3.4.7"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "@neutron-build/nucleus": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
