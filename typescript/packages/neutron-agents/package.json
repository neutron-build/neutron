{
  "name": "@neutron-build/agents",
  "version": "0.1.0",
  "description": "Neutron Agents. File-based agent authoring — agent.ts, instructions.md, tools/ — composing the AI SDK and Workflow SDK into durable agents.",
  "author": "Tyler",
  "license": "MIT",
  "homepage": "https://neutron.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "typescript/packages/neutron-agents"
  },
  "keywords": [
    "neutron",
    "agents",
    "ai",
    "workflow",
    "tools"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test --experimental-test-isolation=none \"dist/**/*.test.js\""
  },
  "peerDependencies": {
    "@neutron-build/ai": "^0.1.0",
    "@neutron-build/workflow": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@neutron-build/workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@neutron-build/ai": "workspace:^",
    "@neutron-build/workflow": "workspace:^",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.2",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
