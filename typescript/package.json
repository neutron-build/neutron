{
  "name": "neutron-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neutron-build/neutron",
    "directory": "ts"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm -r --if-present run build",
    "build:turbo": "turbo run build",
    "test": "node ./scripts/check-workspace-tasks.mjs test && pnpm -r --if-present run test",
    "test:turbo": "turbo run test",
    "lint": "node ./scripts/check-workspace-tasks.mjs lint && pnpm -r --if-present run lint",
    "lint:turbo": "turbo run lint",
    "ci:deploy-presets": "pnpm --dir apps/playground run build:vercel && pnpm --dir apps/playground run deploy-check:vercel && pnpm --dir apps/playground run build:netlify && pnpm --dir apps/playground run deploy-check:netlify && pnpm --dir apps/playground run build:cloudflare && pnpm --dir apps/playground run deploy-check:cloudflare && pnpm --dir apps/playground run build:docker && pnpm --dir apps/playground run deploy-check:docker",
    "ci:deploy-presets:boot": "node ./scripts/deploy-preset-boot-smoke.mjs",
    "ci:runtime-compat": "node ./scripts/runtime-compat-smoke.mjs",
    "ci:aliased-install": "node ./scripts/aliased-install-smoke.mjs",
    "ci:init-smoke": "node ./scripts/init-smoke.mjs",
    "ci:data-profiles": "node ./scripts/data-profile-smoke.mjs",
    "ci:naming": "node ./scripts/naming-check.mjs",
    "ci:workspace": "node ./scripts/workspace-graph-check.mjs",
    "ci:workspace:snapshot": "node ./scripts/workspace-graph-check.mjs --write",
    "ci:render-guards": "node ./scripts/render-guards.mjs",
    "ci:render-guards:snapshot": "node ./scripts/render-guards.mjs --write",
    "ci:bench:smoke": "pnpm --dir benchmarks run compare:quick",
    "ci:bench:full": "pnpm --dir benchmarks run compare:full",
    "ci:bench:canonical": "pnpm --dir benchmarks run compare:canonical",
    "ci:bench:publish": "pnpm --dir benchmarks run compare:publish-grade",
    "ci:bench:publish:preflight": "pnpm --dir benchmarks run compare:publish:preflight",
    "ci:bench:publish:official": "pnpm --dir benchmarks run compare:publish:official",
    "typecheck": "pnpm -r --if-present run typecheck",
    "ci:release": "node ./scripts/release-check.mjs",
    "ci:compat-matrix": "pnpm --filter @neutron/compat-matrix matrix"
  },
  "devDependencies": {
    "better-sqlite3": "^11.5.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.19.2",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "fast-xml-parser@>=5.0.0 <5.7.0": ">=5.7.0",
      "hono@<4.13.14": "^4.13.11",
      "@hono/node-server@<1.19.18": "^1.19.15",
      "effect@<3.20.0": "^3.20.0",
      "lodash@<4.18.0": "^4.18.0",
      "lodash-es@<4.18.0": "^4.18.0",
      "valibot@<1.4.2": "^1.4.2",
      "mysql2@<3.23.1": "^3.23.1",
      "dompurify@<3.4.17": "^3.4.17",
      "nanoid@<3.3.18": "^3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "prismjs@<1.30.0": "^1.30.0",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "sharp@<0.35.5": "^0.35.5",
      "devalue@<5.9.3": "^5.9.3",
      "source-map-js@<1.2.2": "^1.2.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "defu@<6.1.5": "^6.1.5",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "postcss@<8.5.18": "^8.5.18",
      "next@>=16.0.0 <16.4.1": "^16.4.1",
      "browserslist@<4.28.7": "^4.28.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "drizzle-orm": "^0.45.2",
    "prisma": "^5.22.0"
  }
}
