{
  "name": "react-dom-compat-shim",
  "version": "0.0.0",
  "private": true,
  "comment": "See shims/react/package.json -- preact is declared and pinned here for the same reason.",
  "dependencies": {
    "preact": "10.25.4"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "exports": {
    ".": { "import": "./index.mjs", "require": "./index.cjs" },
    "./client": { "import": "./index.mjs", "require": "./index.cjs" },
    "./server": { "import": "./server.mjs", "require": "./server.cjs" },
    "./test-utils": { "import": "./index.mjs", "require": "./index.cjs" }
  }
}
