{
  "name": "@neutron/compat-matrix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ecosystem compatibility harness: mounts real React libraries under preact/compat and publishes the result (A-007).",
  "comment": "Every Radix dependency is pinned exact, not caret-ranged: the 2026-10 lockfile regen silently moved ^1.1.4 to 1.1.23 and friends while docs/react-compat-matrix.md still carried the older specifier numbers, and nothing caught it because the runner's version lookup also fell back to the specifier. The pins below are Fylun's live versions (its lockfile resolves to exactly these); pinning keeps the rows stating the version under test instead of whatever a later regen resolves.",
  "scripts": {
    "matrix": "node run.mjs",
    "matrix:write": "node run.mjs --write"
  },
  "dependencies": {
    "preact": "10.25.4",
    "preact-render-to-string": "^6.5.13",
    "react": "file:./shims/react",
    "react-dom": "file:./shims/react-dom",

    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",

    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",

    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "4.7.0",
    "@tiptap/pm": "3.30.1",
    "@tiptap/react": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "@xyflow/react": "12.11.3",
    "cmdk": "1.1.1",
    "lucide-react": "0.562.0",
    "qrcode.react": "4.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",

    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.5",
    "react-hook-form": "^7.54.0",
    "framer-motion": "^11.15.0",
    "recharts": "^2.15.0",
    "react-day-picker": "^9.4.4",
    "react-syntax-highlighter": "^15.6.1",
    "clsx": "^2.1.1"
  }
}
